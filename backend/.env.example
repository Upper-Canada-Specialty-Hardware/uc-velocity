# UC Velocity ERP - Backend Environment Variables
# Copy this file to .env and fill in the values

# Database connection URL (required)
# For local development with Docker:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ucvelocity

# For Railway (auto-provided):
# DATABASE_URL is automatically set by Railway when you add a PostgreSQL service

# CORS allowed origins (optional)
# Comma-separated list of allowed frontend URLs
# Localhost origins are always included automatically
# CORS_ORIGINS=https://your-frontend.up.railway.app

# UCSH Telemetry (optional) — analytics + the in-app feedback thread.
# Leave BOTH unset and the whole integration is inert: no events, no feedback
# widget, no network. Ask Robert for the two shared values to switch it on.
# TELEMETRY_URL=https://<the-telemetry-service>.up.railway.app
# TELEMETRY_KEY=<the shared ingest key>
# Optional overrides:
# TELEMETRY_SOURCE=uc-velocity       # app slug in the dashboard; never change once live
# APP_VERSION=1.0.0                  # or set from the deploy's git SHA
# TELEMETRY_THREAD_SALT=<random>     # hardens the per-user feedback thread key
# TELEMETRY_INSTALL_ID=uc-velocity-server
